# Bitman — variáveis de ambiente (docker compose + containers via env_file).
# Copie para .env e preencha. O .env NUNCA é versionado.

# --- Domínios ---------------------------------------------------------------
HUB_DOMAIN=bitman.sandrigo.com.br
GAMES_DOMAIN=bitman-games.sandrigo.com.br
HUB_ORIGIN=https://bitman.sandrigo.com.br
GAMES_ORIGIN=https://bitman-games.sandrigo.com.br

# --- Pré-lançamento ----------------------------------------------------------
# Autenticação básica no Traefik para o hub (formato htpasswd com bcrypt, entre aspas simples).
# Gerar: make basic-auth USER=rafael PASS='senha'
BITMAN_BASIC_AUTH=''

# --- Laravel -----------------------------------------------------------------
APP_NAME=Bitman
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bitman.sandrigo.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=bitman
DB_USERNAME=bitman
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# E-mail: definido na Fase 1 (verificação de conta).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responda@sandrigo.com.br
MAIL_FROM_NAME="${APP_NAME}"

# --- git-sandbox (ADR 0003) ---------------------------------------------------
SANDBOX_URL=http://git-sandbox:8080
SANDBOX_TOKEN=
